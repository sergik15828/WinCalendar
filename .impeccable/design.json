      "css": ".ds-event-card-dark{position:relative;display:block;width:309px;height:84px;margin:3px 1px 5px;padding:0;border:1px solid #444444;border-radius:8px;background:#292929;color:#F5F5F5;font-family:\"Segoe UI\",sans-serif;text-align:left;cursor:pointer}.ds-event-card-dark:hover,.ds-event-card-dark:active{background:#383838}.ds-event-card-dark:focus-visible{outline:1px dotted #F5F5F5;outline-offset:-4px}.ds-event-card-dark .ds-event-time{position:absolute;left:12px;right:12px;top:7px;height:18px;font-size:9pt;color:#FF8B91;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-event-card-dark .ds-event-title{position:absolute;left:12px;right:12px;top:27px;height:34px;font-size:10pt;font-weight:700;line-height:17px;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}.ds-event-card-dark .ds-event-source{position:absolute;left:12px;right:12px;top:64px;height:16px;font-size:9pt;color:#BDBDBD;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
