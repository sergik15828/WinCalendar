    {
      "name": "Event card — light",
      "kind": "card",
      "refersTo": "event-card-light",
      "description": "Native event-card preview: accent time, bold two-line title and source-calendar metadata; 92px row pitch.",
      "html": "<button class=\"ds-event-card-light\" type=\"button\" title=\"10:00 — 11:00, Планирование недели — синтетический пример, Команда\"><span class=\"ds-event-time\">10:00 — 11:00</span><span class=\"ds-event-title\">Планирование недели — синтетический пример</span><span class=\"ds-event-source\">Команда</span></button>",
      "css": ".ds-event-card-light{position:relative;display:block;width:309px;height:84px;margin:3px 1px 5px;padding:0;border:1px solid #DEDEDE;border-radius:8px;background:#FFFFFF;color:#202020;font-family:\"Segoe UI\",sans-serif;text-align:left;cursor:pointer}.ds-event-card-light:hover,.ds-event-card-light:active{background:#E8E8E8}.ds-event-card-light:focus-visible{outline:1px dotted #202020;outline-offset:-4px}.ds-event-card-light .ds-event-time{position:absolute;left:12px;right:12px;top:7px;height:18px;font-size:9pt;color:#C42B36;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-event-card-light .ds-event-title{position:absolute;left:12px;right:12px;top:27px;height:34px;font-size:10pt;font-weight:700;line-height:17px;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}.ds-event-card-light .ds-event-source{position:absolute;left:12px;right:12px;top:64px;height:16px;font-size:9pt;color:#626262;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
    },
    {
